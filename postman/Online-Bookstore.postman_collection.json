                "{{bookId}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Create book (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Left Hand of Darkness\",\n  \"author\": \"Ursula K. Le Guin\",\n  \"description\": \"An envoy visits a planet whose people have no fixed gender.\",\n  \"price\": 15.99,\n  \"category\": \"{{categoryId}}\",\n  \"ISBN\": \"9780441478125\",\n  \"stock\": 12,\n  \"image\": \"\",\n  \"featured\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data._id) { pm.collectionVariables.set('bookId', data._id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Update book (admin)",
