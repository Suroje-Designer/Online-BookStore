                ]
              }
            }
          ]
        },
        {
          "name": "Search books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search=habits&sort=price_asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "habits"
                },
                {
                  "key": "sort",
                  "value": "price_asc"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Filter by category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?category={{categoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "{{categoryId}}"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
